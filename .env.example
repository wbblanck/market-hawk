NFLMI_DATABASE_PATH=data/nfl_market.duckdb
NFLMI_MCP_TRANSPORT=stdio
NFLMI_MCP_HOST=127.0.0.1
NFLMI_MCP_PORT=8000
# Optional Sports Leader MCP provider (Node 20+, built server). Unset = provider unavailable.
# NFLMI_SPORTS_LEADER_CMD=node /path/to/sports-leader-mcp/dist/index.js
# NFLMI_SPORTS_LEADER_TIMEOUT=60
# Close policy (docs/methodology/closing_line.md). Changing a value after CLV results exist opens a new experiment id.
# LOCKED by Will: close = last qualifying quote with captured_at_utc <= kickoff_utc - 15 min.
NFLMI_CLOSE_CUTOFF_MINUTES=15
# PROPOSED, needs Will's confirmation: a close quote older than this at the cutoff is missing ("stale").
NFLMI_CLOSE_MAX_AGE_MINUTES=120
# LOCKED by Will: tier 2 (median of Circa and BookMaker) needs at least 2 of those books.
NFLMI_CLOSE_SHARP_MIN_BOOKS=2
# PROPOSED, needs Will's confirmation: tier 3 (all-book median) below this many books is flagged FEW_BOOKS.
NFLMI_CLOSE_FALLBACK_MIN_BOOKS=3
# LOCKED by Will: book-flagged main line, else the most balanced line.
NFLMI_CLOSE_MAIN_LINE_RULE=book_primary_else_most_balanced
# Locked holdout manifest. Default: config/holdout/nfl_games_2025_v1.json in the repo.
# NFLMI_HOLDOUT_MANIFEST_PATH=config/holdout/nfl_games_2025_v1.json
# Optional The Odds API key (free Starter tier serves live Pinnacle; see docs/data_sources/sharp_feeds.md).
# Never commit a real key. Unset = provider unavailable.
# NFLMI_ODDS_API_KEY=
# Optional ParlayAPI key (odds-api-v4 schema; Will's existing key). PARLAY_API_KEY is also read if this is unset.
# NFLMI_PARLAY_API_KEY=
